      "name": "Deutsche Wohnen",
      "baseUrl": "https://www.deutsche-wohnen.com/",
      "countries": ["de"],
      "requiredFieldNames": ["id", "link", "title", "price", "size", "rooms", "address", "image", "description"]
    },
    {
      "id": "flatfox",
      "name": "Flatfox",
      "baseUrl": "https://flatfox.ch/",
      "countries": ["ch"],
      "requiredFieldNames": ["id", "title", "link", "price", "size", "rooms", "address"]
    },
    {
      "id": "immoscout",
      "name": "Immoscout",
      "baseUrl": "https://www.immobilienscout24.de/",
      "countries": ["de"],
      "requiredFieldNames": ["id", "link", "title", "price", "size", "rooms", "address", "image", "description"]
    },
    {
      "id": "inberlinwohnen",
      "name": "InBerlinWohnen",
      "baseUrl": "https://inberlinwohnen.de/",
      "countries": ["de"],
      "requiredFieldNames": ["id", "link", "title", "price", "size", "rooms", "address", "image", "description"]
    },
    {
      "id": "kleinanzeigen",
      "name": "Kleinanzeigen",
      "baseUrl": "https://www.kleinanzeigen.de/",
      "countries": ["de"],
      "requiredFieldNames": ["id", "link", "title", "price", "size", "rooms", "address", "image", "description"]
    },
    {
      "id": "willhaben",
      "name": "willhaben",
      "baseUrl": "https://www.willhaben.at/",
      "countries": ["at"],
      "requiredFieldNames": ["id", "title", "link", "price", "size", "rooms", "address"]
    }
  ],
  "notificationAdapters": [
    {
      "id": "telegram",
      "name": "Telegram",
      "fields": {
        "token": {
          "type": "text",
          "optional": false,
          "secret": true,
          "target": false
        },
        "chatId": {
          "type": "chatId",
          "optional": false,
          "secret": false,
          "target": true
        },
        "messageThreadId": {
          "type": "text",
          "optional": true,
          "secret": false,
          "target": false
        },
        "plainText": {
          "type": "boolean",
          "optional": true,
          "secret": false,
          "target": false
        }
      }
    }
  ],
  "sendCall": {
    "method": "send",
    "arguments": ["serviceName", "newListings", "notificationConfig", "jobKey", "baseUrl"],
    "object": ["serviceName", "newListings", "notificationConfig", "jobKey", "baseUrl"]
  },
  "schedules": [
    {
      "id": "active-checker",
      "cron": "0 */4 * * *",
      "startup": true
    },
    {
      "id": "geocoding",
      "cron": "0 */6 * * *",
      "startup": true
    },
    {
      "id": "listing-retention",
      "cron": "30 3 * * *",
      "startup": true
    },
    {
      "id": "travel-time",
      "cron": "20 */2 * * *",
      "startup": false
    },
    {
      "id": "connectivity",
      "cron": "40 * * * *",
      "startup": true
    }
  ]
}
