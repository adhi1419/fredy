{
  "assumptions": {
    "frontendOrigin": "https://adhi1419.github.io",
    "authentication": "Direct Firebase ID bearer token in Authorization",
    "credentials": "omit",
    "deployment": "Cloud Run API-only; GitHub Pages serves the SPA"
  },
  "rustHealth": {
    "package": "rust/health-route",
    "executable": "fredy-health-route",
    "productionEnabled": false,
    "nodeRemainsAuthoritative": true,
    "bindAddress": "0.0.0.0",
    "portFallback": 9998
  },
  "http": {
    "health": {
      "method": "GET",
      "path": "/health",
      "status": 200,
      "contentType": "application/json; charset=utf-8",
      "bodyBytes": "{\"status\":\"ok\"}",
      "body": { "status": "ok" }
    },
    "apiOnlyFallback": {
      "method": "GET",
      "path": "/not-a-route",
      "status": 404,
      "contentType": "application/json; charset=utf-8",
      "bodyBytes": "{\"error\":\"Not found\"}",
      "body": { "error": "Not found" }
    },
    "authConfig": {
      "method": "GET",
      "path": "/api/auth/config",
      "cases": [
        {
          "name": "enabled",
          "environment": {
            "FIREBASE_WEB_CONFIG": "{\"apiKey\":\"public-key\",\"projectId\":\"fredy\"}"
          },
          "status": 200,
          "contentType": "application/json; charset=utf-8",
          "bodyBytes": "{\"enabled\":true,\"firebaseConfig\":{\"apiKey\":\"public-key\",\"projectId\":\"fredy\"}}",
          "body": {
            "enabled": true,
            "firebaseConfig": { "apiKey": "public-key", "projectId": "fredy" }
          }
        },
        {
          "name": "absent",
          "environment": {},
          "status": 200,
          "contentType": "application/json; charset=utf-8",
          "bodyBytes": "{\"enabled\":false,\"firebaseConfig\":null}",
          "body": { "enabled": false, "firebaseConfig": null }
        },
        {
          "name": "invalid",
          "environment": { "FIREBASE_WEB_CONFIG": "not-json" },
          "status": 200,
          "contentType": "application/json; charset=utf-8",
          "bodyBytes": "{\"enabled\":false,\"firebaseConfig\":null}",
          "body": { "enabled": false, "firebaseConfig": null }
        }
      ]
    },
    "authMe": {
      "method": "GET",
      "path": "/api/auth/me",
      "success": {
        "status": 200,
        "body": { "userId": "uid-alice", "username": "alice@example.com", "isAdmin": false }
      },
      "failures": {
        "missingBearer": { "status": 401, "body": { "reason": "invalid authorization" } },
        "invalidToken": { "status": 401, "body": { "reason": "invalid token" } },
        "invalidClaims": { "status": 401, "body": { "reason": "invalid token claims" } },
        "notAllowed": { "status": 403, "body": { "reason": "not allowed" } }
      }
    }
  },
  "cors": {
    "allowOrigin": "https://adhi1419.github.io",
    "allowMethods": "GET,POST,PUT,DELETE,OPTIONS",
    "allowHeaders": "Authorization,Content-Type",
    "maxAge": "86400",
    "vary": "Origin"
  },
  "sse": {
    "contentType": "text/event-stream",
    "heartbeatIntervalMs": 25000,
    "handshake": ": connected\n\n",
    "hello": "event: hello\ndata: {\"ok\":true}\n\n",
    "jobStatus": "event: jobStatus\ndata: {\"running\":true}\n\n",
    "heartbeatPattern": "^: ping [0-9]+\\n\\n$"
  }
}
